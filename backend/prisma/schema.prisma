generator client {
  provider        = "prisma-client-js"
  // Lets Prisma Migrate manage PostgreSQL extensions (needed for `unaccent`).
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  // DATABASE_URL → app (Neon: pooled, host contains "-pooler"; local Docker: normal URL)
  // DIRECT_URL   → Prisma Migrate (Neon: direct, no "-pooler"; local Docker: same as DATABASE_URL)
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  // CREATE EXTENSION IF NOT EXISTS unaccent — accent-insensitive search ("zolw" → "żółw").
  extensions = [unaccent]
}

model Category {
  id    String @id @default(uuid())
  name  String @unique
  slug  String @unique
  signs Sign[]
}

model Sign {
  id          String   @id @default(uuid())
  name        String
  description String?
  video_url   String
  category_id String
  category    Category @relation(fields: [category_id], references: [id], onDelete: Cascade)
}

model Alphabet {
  id               String  @id @default(uuid())
  letter           String  @unique
  video_url        String
  /// true → letter is fingerspelled with hand movement (dynamic sign); false → static handshape.
  requiresMovement Boolean @default(false) @map("requires_movement")
}
