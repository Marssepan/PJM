# ---------- Local development (Docker PostgreSQL) ----------
DATABASE_URL=postgresql://admin:root@localhost:5432/pjm_dictionary
DIRECT_URL=postgresql://admin:root@localhost:5432/pjm_dictionary
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
PORT=3001
# Folder with .mp4 files, relative to backend/ (only used locally — production serves videos from GitHub Pages)
VIDEOS_DIR=public/videos

